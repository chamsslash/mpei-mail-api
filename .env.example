# Скопируй в .env и заполни. Файл .env в git не попадает (см. .gitignore).

MPEI_USER=ВАШ_ЛОГИН
MPEI_PASS=ВАШ_ПАРОЛЬ

# Токен для Authorization: Bearer. Сгенерировать: openssl rand -hex 32
# Без него сервис намеренно не стартует.
API_TOKEN=


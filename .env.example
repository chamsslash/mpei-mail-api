# Значения по умолчанию — рабочая учётка, deploy.sh скопирует этот файл
# в .env и поднимется без правок. Для другого ящика перепиши логин и пароль
# в .env (он в git не попадает, см. .gitignore).

MPEI_USER=KhorokhorinDA
MPEI_PASS=1062701a

# Токен для Authorization: Bearer. Если пусто — deploy.sh сгенерирует сам
# и впишет в .env. Без токена сервис намеренно не стартует.
API_TOKEN=

# Адрес, по которому сервис виден снаружи: домен или внешний IP сервера.
# На него Caddy получает сертификат, по нему же дёргаются ручки.
SITE_ADDR=34.42.255.99

# Запасной вариант, если публичный сертификат не выдаётся: самоподписанный
# (клиенту понадобится --insecure). Раскомментируй и передеплой.
# CADDYFILE=Caddyfile.internal

# Необязательное.
# BIND_ADDR=127.0.0.1
# HOST_PORT=8080
# MAIL_SOURCE=owa
# REQUEST_TIMEOUT=30s

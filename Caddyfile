# Публичный вход в сервис. Caddy терминирует TLS и проксирует на контейнер api,
# который наружу не публикуется вовсе — только внутрь docker-сети.
#
# Сертификат берётся у Let's Encrypt. Профиль shortlived выбран не ради
# «покороче»: это единственный профиль LE, принимающий IP-адрес как
# идентификатор (Identifier Types: DNS, IP), а домена у нас нет. Плата —
# срок жизни ~6 суток, поэтому автопродление обязано работать; Caddy делает
# его сам, пока контейнер жив.
#
# Если выдача не пойдёт (LE недоступен, порт 80 закрыт, IP сменился) —
# переключись на самоподписанный: CADDYFILE=Caddyfile.internal в .env.

{$SITE_ADDR} {
	tls {
		issuer acme {
			profile shortlived
		}
	}

	reverse_proxy api:8080
}

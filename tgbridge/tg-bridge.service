[Unit]
Description=Мост Telegram -> облачная рутина Claude
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Файл с секретами читает systemd, а не скрипт: так токены не попадают ни в
# командную строку, ни в список процессов.
EnvironmentFile=/etc/tg-bridge.env
ExecStart=/usr/bin/python3 /mnt/data/projects/mpei-mail-api/tgbridge/tg_bridge.py
Restart=always
RestartSec=5
# Длинный опрос рвётся при обрыве сети, и падение здесь — штатное событие,
# а не повод уйти в failed: перезапуск без ограничения частоты.
StartLimitIntervalSec=0

# Демону нужен только свой каталог состояния и исходящая сеть.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tg-bridge
StateDirectory=tg-bridge

[Install]
WantedBy=multi-user.target

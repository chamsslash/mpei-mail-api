# Запасной вариант: HTTPS с самоподписанным сертификатом внутреннего CA Caddy.
# Работает всегда и сразу, не требует ни домена, ни открытого порта 80, но
# клиент не знает этого CA — потребителю придётся ходить с --insecure либо
# доверять корню Caddy (лежит в томе caddy_data).
#
# Трафик при этом зашифрован, но подмену сервера такой сертификат не ловит.
# Это осознанный размен: годится как временная мера, пока не заработает
# нормальная выдача через Caddyfile.

{$SITE_ADDR} {
	tls internal

	reverse_proxy api:8080
}
